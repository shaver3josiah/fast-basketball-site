{
  "name": "fast-basketball-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "validate:suburbs": "node scripts/validate-suburbs.mjs",
    "extract:images": "node scripts/extract-images.mjs",
    "split:sections": "node scripts/split-sections.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "golden:snapshot": "node scripts/golden.mjs snapshot",
    "golden:check": "node scripts/golden.mjs check",
    "dev": "node scripts/dev-server.mjs",
    "serve": "node build.mjs && npx --yes serve dist -l 8888"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "moveable": "^0.53.0",
    "sharp": "^0.35.3"
  }
}
