{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "trailingSlash": false,
    "appAssociation": "NONE",
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } }
    ],
    "redirects": [
      { "source": "/coach", "destination": "/coach-blake-kingsley", "type": 301 },
      { "source": "/training", "destination": "/training/evaluation", "type": 301 },
      { "source": "/training/small-group", "destination": "/training/group-training", "type": 301 },
      { "source": "/free-session", "destination": "/training/evaluation", "type": 301 },
      { "source": "/basketball-training", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/kendall", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/pinecrest", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/coral-gables", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/doral", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/westchester", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/miami-lakes", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/palmetto-bay", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/aventura", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/weston", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/pembroke-pines", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/miramar", "destination": "/#areas", "type": 301 },
      { "source": "/basketball-training/cooper-city", "destination": "/#areas", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
          { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; upgrade-insecure-requests" }
        ]
      },
      {
        "source": "/images/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/styles/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/js/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/brand/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/fonts/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "/admin{,/**}",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      },
      {
        "source": "/api{,/**}",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/enroll/thanks{,/**}",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "site-api",
    "ignore": ["node_modules", ".git", "*.local"],
    "predeploy": ["npm run pack:functions"]
  },
  "emulators": {
    "hosting": { "port": 5000 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8081 },
    "ui": { "enabled": true, "port": 4001 },
    "singleProjectMode": true
  }
}
