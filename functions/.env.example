# Copy to functions/.env and fill in. That file is gitignored and is what
# `firebase deploy --only functions` uploads as the deployed function's environment.
#
# These are the same names the Netlify environment used, so nothing in the handler code
# changed. Anything left blank degrades honestly rather than crashing: no Stripe key means
# checkout saves the registration and answers "payments not configured", and no Resend key
# means leads are stored but nobody is emailed.
#
# Values here are readable by anyone with project access in the Cloud console, exactly as
# Netlify's environment variables were. To harden the three that matter most, move them to
# Secret Manager later:
#   npx firebase-tools functions:secrets:set STRIPE_SECRET_KEY
# and add `secrets: ['STRIPE_SECRET_KEY', ...]` to the onRequest options in index.mjs.

# --- Stripe. Until these are set, /enroll saves registrations and takes no money. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend). Without these, leads are stored silently and Blake is not told. ---
RESEND_API_KEY=
PLAYBOOK_FROM_EMAIL=coach@fast-basketball.com
# Where owner alerts go. Defaults to CONTACT.email in src/lib/site-config.mjs.
ENROLL_NOTIFY_EMAIL=

# --- Admin panel at /admin ---
ADMIN_PASSWORD=
# Any long random string. Changing it signs every admin session out.
ADMIN_SESSION_SECRET=

# --- Publishing. The admin panel's Publish button commits through the GitHub API, and
#     .github/workflows/deploy.yml turns that commit into a Hosting deploy. ---
GITHUB_TOKEN=
GITHUB_REPO=shaver3josiah/fast-basketball-site
GITHUB_BRANCH=main
